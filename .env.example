# Private research key. Generate a fresh key for your own installation.
WATERMARK_RESEARCH_KEY=replace_with_a_private_integer

# Optional hosted model credentials. Never commit your real .env file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional Ollama server URL.
OLLAMA_BASE_URL=http://localhost:11434

# Optional Hugging Face access token for gated models.
HF_TOKEN=
