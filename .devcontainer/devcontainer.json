{
  "name": "LLM Watermark Lab",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.codespaces.yml"],
  "service": "web",
  "workspaceFolder": "/app",
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "LLM Watermark Lab", "onAutoForward": "openBrowser", "visibility": "private"}},
  "postCreateCommand": "python -m unittest discover -s tests -v",
  "remoteEnv": {"PYTHONUNBUFFERED": "1"},
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}}
}
